// ============================================================================
// firestore.rules
// Reglas de seguridad Firestore — AIP_v1.2.1
// ============================================================================
// ORIGEN  : SEC-VEC-01 patch — Lead Architect (despachos_04.1.2 · B_IMPACT_sec_vec_01.md)
// SESIÓN  : VIBE-AIP-S-REBORN-04.1 · 2026-06-05
// ESTADO  : PENDIENTE DE DEPLOY (firebase deploy --only firestore:rules)
// ============================================================================
// NOTA DE DEPLOY:
//   1. Instalar Firebase CLI: npm install -g firebase-tools
//   2. firebase login
//   3. firebase use <project-id>
//   4. firebase deploy --only firestore:rules
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Regla R0 — Colección users ─────────────────────────────────────────
    // El cliente solo puede leer y crear su propio documento.
    // La actualización de KYC queda reservada exclusivamente a Cloud Functions.
    match /users/{userId} {
      // Lectura: solo el propio usuario autenticado
      allow read: if request.auth != null && request.auth.uid == userId;

      // Creación: solo el propio usuario, solo con kyc:'pending'
      // Impide auto-aprobación de KYC en el momento del registro.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.kyc == 'pending'
                    && request.resource.data.status == 'REGISTERED';

      // Actualización: BLOQUEADA para el cliente.
      // Solo modificable vía Cloud Functions con privilegios de Admin SDK.
      allow update: if false;

      // Borrado: BLOQUEADO.
      allow delete: if false;
    }

    // ── Regla R1 — Colección assets ────────────────────────────────────────
    // Acceso restringido a usuarios autenticados del mismo tenant con KYC verificado.
    // La lectura de activos exige kyc_verified: true en los Custom Claims del token.
    // (Precondición: kyc aprobado por Cloud Function → setCustomUserClaims)
    match /assets/{assetId} {
      allow read: if request.auth != null
                  && request.auth.token.kyc_verified == true;

      // Escritura: BLOQUEADA para el cliente.
      // Solo modificable vía Cloud Functions firmadas (ed25519 o Admin SDK).
      allow write: if false;
    }

    // ── Funciones Auxiliares de Gobernanza ─────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['superadmin', 'partner', 'desk_manager'];
    }

    function hasClearanceMember() {
      // Valida clearance estructural (level >= 1) del Custom Claim fiduciario
      return isAuthenticated() && request.auth.token.level >= 1;
    }

    function mandateExists(mandateId) {
      return exists(/databases/$(database)/documents/mandates/$(mandateId));
    }

    function isMandateMember(mandateId) {
      return request.auth.uid in get(/databases/$(database)/documents/mandates/$(mandateId)).data.members;
    }

    function isMandateAdmin(mandateId) {
      return request.auth.uid == get(/databases/$(database)/documents/mandates/$(mandateId)).data.ownerId;
    }

    // ── Regla R3 — Colección mandates (lectura para demo + CRM tree) ───────
    // [SEC-AIP-01] Solo pueden leer mandatos los miembros del mandato o admins.
    // Eliminado: allow read: if isAuthenticated() — exponía todos los mandatos a
    // cualquier cuenta autenticada sin verificación de membresía o clearance.
    match /mandates/{mandateId} {
      allow read: if isAuthenticated() && (isMandateMember(mandateId) || isAdmin());
      allow write: if false;
    }

    // ── Regla R2 — Subcolección Documents de Mandatos ──────────────────────
    // Origen: E6-DOC-03 · Lead Architect · ronda 04.2.2
    match /mandates/{mandateId}/documents/{documentId} {

      allow read: if isAuthenticated()
                  && (isMandateMember(mandateId) || isAdmin());

      allow create: if isAuthenticated()
                    && hasClearanceMember()
                    && mandateExists(mandateId)
                    // Zero-Leak: el documento debe inyectarse en el mandato correcto
                    && request.resource.data.mandateId == mandateId;

      allow delete: if isAuthenticated()
                    && (isMandateAdmin(mandateId) || isAdmin());

      // Los documentos fiduciarios son inmutables tras su carga (borrar + recrear)
      allow update: if false;
    }

    // ── agent_documents/{docId} — documentos propios del Desktop del Agente
    // (ORB4-DESKTOP-AGENTE-01, yacimiento [N-34]) — owner-scoped por `uid`,
    // mismo patrón que R2 ──────────────────────────────────────────────────
    match /agent_documents/{docId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Inmutables tras su carga (borrar + recrear) — mismo criterio que R2
      allow update: if false;
    }

    // ── kyc_submissions / kyc_l4_submissions / kyc_kyb_submissions /
    // audit_log — READ-ONLY para cliente, owner u admin. La ESCRITURA queda
    // exclusivamente al dispatcher `executeUserAction` (Cloud Functions,
    // Admin SDK bypasa estas reglas) — despacho 08-01.1.2, CCD Pregunta 18.
    match /kyc_submissions/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /kyc_l4_submissions/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /kyc_kyb_submissions/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /audit_log/{uid}/events/{eventId} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ── Regla por defecto — Negar todo lo no especificado ──────────────────
    // NOTA: qr_tokens (handoff QR móvil) queda FUERA de este bloque a
    // propósito — modelo de auth del "lado móvil" pendiente (CCD P3,
    // 01_AUDITORIA_FIRESTORE_RULES.md [SEC-05]).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
